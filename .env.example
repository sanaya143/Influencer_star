# Optional. The recommended way to choose the model and paste the access token is the in-app
# Settings page (Campaign Studio > Settings). Values saved there override anything below.
LLM_MODE=auto                  # auto | llm | offline
# LLM_PROVIDER=openrouter      # gemini | openrouter | openai | anthropic | ollama | custom
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_BASE_URL=http://localhost:11434   # fallback only: a Base URL saved in Settings (per provider) wins
# Provider token fallbacks (used only if no token is saved in Settings):
# GOOGLE_API_KEY=  OPENROUTER_API_KEY=  OPENAI_API_KEY=  ANTHROPIC_API_KEY=
# Optional pricing (USD per 1M tokens). Cost is only displayed when both are set.
# LLM_PRICE_INPUT_PER_M=
# LLM_PRICE_OUTPUT_PER_M=

# MCP server (Model Context Protocol) exposed at http://localhost:8000/mcp  (see README > MCP server)
# ZYLO_MCP_TOKEN=             # when set, clients must send "Authorization: Bearer <token>"
# ZYLO_MCP_WRITES=1           # also expose create_product / adjust_stock / set_product_status / place_order; ignored unless a token is set
# ZYLO_MCP_ALLOWED_HOSTS=     # extra Host header values for a deployed server, e.g. zylo.example.com
# ZYLO_MCP_ALLOWED_ORIGINS=   # extra Origin values for browser-based MCP clients

# Outside creator data, fetched over MCP by the Matching Coordinator (see README > Outside creator data over MCP)
# ZYLO_EXTERNAL_MCP=off        # default on; also switchable in Settings
# ZYLO_EXTERNAL_MCP_URL=       # a real provider's Streamable HTTP MCP endpoint (default: bundled mock over stdio)
# ZYLO_EXTERNAL_MCP_TOKEN=     # bearer token for that provider, if it needs one

# Zylo Reach rate limits and spend control (see README > Security)
# ZYLO_RATE_LIMITS=off              # switch all rate limits off (default on)
# ZYLO_RATE_CHAT_MESSAGE=20,300     # per minute, per day
# ZYLO_RATE_CAMPAIGN_RUN=6,60
# ZYLO_RATE_MODEL_TEST=10
# ZYLO_DAILY_TOKEN_BUDGET=200000    # refuse new model calls once today's tokens reach this
