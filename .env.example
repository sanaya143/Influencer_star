# Optional. The recommended way to choose the model and paste the access token is the in-app
# Settings page (Campaign Studio > Settings). Values saved there override anything below.
LLM_MODE=auto                  # auto | llm | offline
# LLM_PROVIDER=openrouter      # gemini | openrouter | openai | anthropic | ollama | custom
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_BASE_URL=http://localhost:11434
# Provider token fallbacks (used only if no token is saved in Settings):
# GOOGLE_API_KEY=  OPENROUTER_API_KEY=  OPENAI_API_KEY=  ANTHROPIC_API_KEY=
# Optional pricing (USD per 1M tokens). Cost is only displayed when both are set.
# LLM_PRICE_INPUT_PER_M=
# LLM_PRICE_OUTPUT_PER_M=
